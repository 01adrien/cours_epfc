@startuml
left to right direction

skinparam packageStyle rectangle

actor "Administrateur plateforme" as AP
actor "Coach administrateur" as CA
actor "Administrateur organisation" as AO
actor "Coach" as C
actor "Runner" as R

rectangle "Plateforme de coaching sportif" {

    package "Gestion de la plateforme" {
        usecase "Créer une organisation" as UC_CreateOrg
        usecase "Gérer une organisation" as UC_ManageOrg
        usecase "Gérer les quotas" as UC_Quota
        usecase "Traiter une demande\nde quota" as UC_QuotaRequest
    }

    package "Gestion des ressources" {
        usecase "Gérer les ressources\nde base" as UC_BaseResources
        usecase "Consulter les ressources\ndisponibles" as UC_ViewResources
        usecase "Créer une Training Resource" as UC_CreateResource
        usecase "Copier une Training Resource" as UC_CopyResource
        usecase "Réaffecter les ressources" as UC_ReassignResource
    }

    package "Gestion de l'organisation" {
        usecase "Créer un coach" as UC_CreateCoach
        usecase "Supprimer un coach" as UC_DeleteCoach
        usecase "Gérer les utilisateurs" as UC_Users
        usecase "Réaffecter un runner" as UC_ReassignRunner
        usecase "Demander une modification\nde quota" as UC_RequestQuota
    }

    package "Gestion des entraînements" {
        usecase "Créer une Training Session" as UC_CreateSession
        usecase "Créer un Training Plan" as UC_CreatePlan
        usecase "Gérer un Training Plan" as UC_ManagePlan
        usecase "Attribuer un Training Plan" as UC_AssignPlan
    }

    package "Suivi des runners" {
        usecase "Créer un runner" as UC_CreateRunner
        usecase "Gérer un runner" as UC_ManageRunner
        usecase "Consulter les résultats" as UC_Results
        usecase "Consulter le détail\nbloc par bloc" as UC_BlockResults
        usecase "Consulter le dashboard" as UC_Dashboard
        usecase "Consulter les statistiques\net graphiques" as UC_Stats
    }

    package "Application mobile / API" {
        usecase "Récupérer son entraînement" as UC_GetTraining
        usecase "Réaliser une séance" as UC_PerformSession
        usecase "Transmettre les résultats" as UC_SendResults
        usecase "Synchroniser les résultats" as UC_SyncResults
    }


    ' =========================
    ' Administrateur plateforme
    ' =========================

    AP --> UC_CreateOrg
    AP --> UC_ManageOrg
    AP --> UC_Quota
    AP --> UC_QuotaRequest


    ' =========================
    ' Coach administrateur
    ' =========================

    CA --> UC_BaseResources
    CA --> UC_CreateResource
    CA --> UC_CopyResource


    ' =========================
    ' Administrateur organisation
    ' =========================

    AO --> UC_CreateCoach
    AO --> UC_DeleteCoach
    AO --> UC_Users
    AO --> UC_ReassignRunner
    AO --> UC_ReassignResource
    AO --> UC_RequestQuota


    ' =========================
    ' Coach
    ' =========================

    C --> UC_CreateRunner
    C --> UC_ManageRunner

    C --> UC_ViewResources
    C --> UC_CreateResource
    C --> UC_CopyResource

    C --> UC_CreateSession
    C --> UC_CreatePlan
    C --> UC_ManagePlan
    C --> UC_AssignPlan

    C --> UC_Results
    C --> UC_BlockResults
    C --> UC_Dashboard
    C --> UC_Stats


    ' =========================
    ' Runner
    ' =========================

    R --> UC_GetTraining
    R --> UC_PerformSession
    R --> UC_SendResults
    R --> UC_SyncResults


    ' =========================
    ' Relations
    ' =========================

    UC_QuotaRequest --> UC_Quota : <<include>>

    UC_ManagePlan --> UC_CreateSession : <<include>>
    UC_AssignPlan --> UC_ManagePlan : <<include>>

    UC_Results --> UC_BlockResults : <<include>>
    UC_Dashboard --> UC_Stats : <<include>>

    UC_SendResults --> UC_SyncResults : <<include>>

    UC_CreateResource --> UC_ViewResources : <<include>>
    UC_CopyResource --> UC_ViewResources : <<include>>

}

@enduml
